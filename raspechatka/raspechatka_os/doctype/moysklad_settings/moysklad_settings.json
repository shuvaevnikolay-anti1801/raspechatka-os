{
 "doctype": "DocType",
 "name": "MoySklad Settings",
 "module": "Raspechatka OS",
 "issingle": 1,
 "track_changes": 1,
 "field_order": [
  "connection_section",
  "access_token",
  "enabled",
  "sync_interval_minutes",
  "state_section",
  "status",
  "account_name",
  "last_checked_at",
  "last_error",
  "last_preview_json",
  "catalog_sync_section",
  "catalog_sync_status",
  "last_catalog_sync_at",
  "catalog_sync_error",
  "catalog_sync_stats_json",
  "sales_sync_section",
  "sales_sync_enabled",
  "sales_sync_from",
  "sales_sync_interval_minutes",
  "sales_sync_status",
  "sales_sync_started_at",
  "sales_sync_heartbeat_at",
  "sales_sync_cursor",
  "last_sales_sync_at",
  "sales_sync_error",
  "sales_sync_stats_json",
  "stock_history_section",
  "stock_history_status",
  "stock_history_last_audit_at",
  "stock_history_error",
  "stock_history_preview_json",
  "stock_history_initialized",
  "stock_history_last_sync_at",
  "stock_history_stats_json",
  "opening_stock_section",
  "opening_stock_status",
  "opening_stock_preview_token",
  "opening_stock_preview_json",
  "opening_stock_documents_json",
  "opening_stock_imported_at",
  "opening_stock_error"
 ],
 "fields": [
  {
   "fieldname": "connection_section",
   "fieldtype": "Section Break",
   "label": "Подключение к МоемуСкладу"
  },
  {
   "fieldname": "access_token",
   "fieldtype": "Password",
   "label": "Токен доступа"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Фоновое чтение включено",
   "default": "0"
  },
  {
   "fieldname": "sync_interval_minutes",
   "fieldtype": "Select",
   "label": "Интервал чтения, минут",
   "options": "15\n30\n60\n180\n360\n720\n1440",
   "default": "60",
   "reqd": 1
  },
  {
   "fieldname": "state_section",
   "fieldtype": "Section Break",
   "label": "Состояние"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Статус",
   "options": "Not configured\nConnected\nError",
   "default": "Not configured",
   "read_only": 1
  },
  {
   "fieldname": "account_name",
   "fieldtype": "Data",
   "label": "Учётная запись",
   "read_only": 1
  },
  {
   "fieldname": "last_checked_at",
   "fieldtype": "Datetime",
   "label": "Последнее чтение",
   "read_only": 1
  },
  {
   "fieldname": "last_error",
   "fieldtype": "Small Text",
   "label": "Последняя ошибка",
   "read_only": 1
  },
  {
   "fieldname": "last_preview_json",
   "fieldtype": "Long Text",
   "label": "Последний обзор данных",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "catalog_sync_section",
   "fieldtype": "Section Break",
   "label": "Одноразовый перенос каталога"
  },
  {
   "fieldname": "catalog_sync_status",
   "fieldtype": "Select",
   "label": "Статус переноса",
   "options": "Idle\nQueued\nRunning\nCompleted\nError",
   "default": "Idle",
   "read_only": 1
  },
  {
   "fieldname": "last_catalog_sync_at",
   "fieldtype": "Datetime",
   "label": "Последний перенос",
   "read_only": 1
  },
  {
   "fieldname": "catalog_sync_error",
   "fieldtype": "Long Text",
   "label": "Ошибка переноса",
   "read_only": 1
  },
  {
   "fieldname": "catalog_sync_stats_json",
   "fieldtype": "Long Text",
   "label": "Статистика переноса",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "sales_sync_section",
   "fieldtype": "Section Break",
   "label": "Временная синхронизация продаж"
  },
  {
   "fieldname": "sales_sync_enabled",
   "fieldtype": "Check",
   "label": "Автоматическая синхронизация продаж",
   "default": "0"
  },
  {
   "fieldname": "sales_sync_from",
   "fieldtype": "Date",
   "label": "Загружать историю с",
   "default": "2026-07-01",
   "read_only": 1
  },
  {
   "fieldname": "sales_sync_interval_minutes",
   "fieldtype": "Select",
   "label": "Интервал синхронизации, минут",
   "options": "5\n15\n30\n60",
   "default": "5",
   "reqd": 1
  },
  {
   "fieldname": "sales_sync_status",
   "fieldtype": "Select",
   "label": "Статус синхронизации продаж",
   "options": "Idle\nQueued\nRunning\nCompleted\nError",
   "default": "Idle",
   "read_only": 1
  },
  {
   "fieldname": "sales_sync_started_at",
   "fieldtype": "Datetime",
   "label": "Начало текущей синхронизации",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "sales_sync_heartbeat_at",
   "fieldtype": "Datetime",
   "label": "Активность текущей синхронизации",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "sales_sync_cursor",
   "fieldtype": "Datetime",
   "label": "Курсор синхронизации",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "last_sales_sync_at",
   "fieldtype": "Datetime",
   "label": "Последняя синхронизация продаж",
   "read_only": 1
  },
  {
   "fieldname": "sales_sync_error",
   "fieldtype": "Long Text",
   "label": "Ошибка синхронизации продаж",
   "read_only": 1
  },
  {
   "fieldname": "sales_sync_stats_json",
   "fieldtype": "Long Text",
   "label": "Статистика синхронизации продаж",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "stock_history_section",
   "fieldtype": "Section Break",
   "label": "Временная синхронизация складской истории"
  },
  {
   "default": "Idle",
   "fieldname": "stock_history_status",
   "fieldtype": "Select",
   "label": "Статус аудита складской истории",
   "options": "Idle\nRunning\nAudited\nCompleted\nCompleted with errors\nError",
   "read_only": 1
  },
  {
   "fieldname": "stock_history_last_audit_at",
   "fieldtype": "Datetime",
   "label": "Последний аудит складской истории",
   "read_only": 1
  },
  {
   "fieldname": "stock_history_error",
   "fieldtype": "Long Text",
   "label": "Ошибка аудита складской истории",
   "read_only": 1
  },
  {
   "fieldname": "stock_history_preview_json",
   "fieldtype": "Long Text",
   "hidden": 1,
   "label": "Результат аудита складской истории",
   "read_only": 1
  },
  {
   "default": "0",
   "fieldname": "stock_history_initialized",
   "fieldtype": "Check",
   "hidden": 1,
   "label": "Историческая точка создана",
   "read_only": 1
  },
  {
   "fieldname": "stock_history_last_sync_at",
   "fieldtype": "Datetime",
   "label": "Последний перенос складской истории",
   "read_only": 1
  },
  {
   "fieldname": "stock_history_stats_json",
   "fieldtype": "Long Text",
   "hidden": 1,
   "label": "Статистика переноса складской истории",
   "read_only": 1
  },
  {
   "fieldname": "opening_stock_section",
   "fieldtype": "Section Break",
   "label": "Одноразовый перенос начальных остатков"
  },
  {
   "fieldname": "opening_stock_status",
   "fieldtype": "Select",
   "label": "Статус начальных остатков",
   "options": "Idle\nPreviewed\nImported\nError",
   "default": "Idle",
   "read_only": 1
  },
  {
   "fieldname": "opening_stock_preview_token",
   "fieldtype": "Data",
   "label": "Ключ проверенного снимка",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "opening_stock_preview_json",
   "fieldtype": "Long Text",
   "label": "Проверенный снимок остатков",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "opening_stock_documents_json",
   "fieldtype": "Long Text",
   "label": "Созданные инвентаризации",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "opening_stock_imported_at",
   "fieldtype": "Datetime",
   "label": "Остатки перенесены",
   "read_only": 1
  },
  {
   "fieldname": "opening_stock_error",
   "fieldtype": "Long Text",
   "label": "Ошибка переноса остатков",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  }
 ]
}
