{
 "doctype": "DocType",
 "name": "Payroll Accrual Type",
 "module": "Raspechatka OS",
 "autoname": "hash",
 "title_field": "component_name",
 "track_changes": 1,
 "field_order": [
  "identity_section",
  "component_code",
  "component_name",
  "active",
  "business_entity",
  "business_point",
  "calculation_section",
  "calculation_basis",
  "default_rate",
  "default_percent",
  "payment_section",
  "payment_method",
  "tax_section",
  "include_in_ndfl_base",
  "include_in_insurance_base",
  "include_in_injury_base",
  "exemption_basis",
  "notes"
 ],
 "fields": [
  {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "Вид начисления"},
  {"fieldname": "component_code", "fieldtype": "Data", "label": "Код", "reqd": 1, "in_list_view": 1},
  {"fieldname": "component_name", "fieldtype": "Data", "label": "Название", "reqd": 1, "in_list_view": 1, "in_global_search": 1},
  {"fieldname": "active", "fieldtype": "Check", "label": "Действует", "default": "1", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "business_entity", "fieldtype": "Link", "label": "Юридическое лицо", "options": "Business Entity", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "business_point", "fieldtype": "Link", "label": "Переопределение для точки", "options": "Business Point", "in_list_view": 1, "in_standard_filter": 1, "description": "Оставьте пустым для настройки по умолчанию всего юридического лица"},
  {"fieldname": "calculation_section", "fieldtype": "Section Break", "label": "Расчёт"},
  {"fieldname": "calculation_basis", "fieldtype": "Select", "label": "Основание расчёта", "options": "Hours\nPersonal Sales\nFixed Amount\nManual\nExternal Result", "reqd": 1, "default": "Manual"},
  {"fieldname": "default_rate", "fieldtype": "Currency", "label": "Ставка / сумма по умолчанию"},
  {"fieldname": "default_percent", "fieldtype": "Percent", "label": "Процент по умолчанию"},
  {"fieldname": "payment_section", "fieldtype": "Section Break", "label": "Выплата"},
  {"fieldname": "payment_method", "fieldtype": "Select", "label": "Способ выплаты", "options": "Bank Transfer\nCash", "reqd": 1, "default": "Bank Transfer", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "tax_section", "fieldtype": "Section Break", "label": "Налоговые базы"},
  {"fieldname": "include_in_ndfl_base", "fieldtype": "Check", "label": "Включать в базу НДФЛ", "default": "1"},
  {"fieldname": "include_in_insurance_base", "fieldtype": "Check", "label": "Включать в базу страховых взносов", "default": "1"},
  {"fieldname": "include_in_injury_base", "fieldtype": "Check", "label": "Включать в базу взносов от несчастных случаев", "default": "1"},
  {"fieldname": "exemption_basis", "fieldtype": "Small Text", "label": "Основание исключения из налоговой базы", "description": "Обязательно, если хотя бы одна база выключена: статья закона, вид компенсации или заключение бухгалтера"},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "Комментарий"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "import": 1}
 ]
}

