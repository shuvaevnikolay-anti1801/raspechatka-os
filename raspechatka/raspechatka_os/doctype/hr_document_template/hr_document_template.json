{
 "doctype": "DocType",
 "name": "HR Document Template",
 "module": "Raspechatka OS",
 "autoname": "hash",
 "title_field": "template_name",
 "track_changes": 1,
 "field_order": ["template_name", "document_type", "version", "active", "template_html", "notes"],
 "fields": [
  {"fieldname": "template_name", "fieldtype": "Data", "label": "Название шаблона", "reqd": 1, "in_list_view": 1},
  {"fieldname": "document_type", "fieldtype": "Select", "label": "Вид документа", "options": "Трудовой договор\nПерсональные данные\nДолжностные обязанности\nНеразглашение", "reqd": 1, "in_list_view": 1},
  {"fieldname": "version", "fieldtype": "Int", "label": "Версия", "default": "1", "read_only": 1, "in_list_view": 1},
  {"fieldname": "active", "fieldtype": "Check", "label": "Действует", "default": "1", "in_list_view": 1},
  {"fieldname": "template_html", "fieldtype": "Text Editor", "label": "Содержание", "reqd": 1},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "Комментарий"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1}
 ]
}
